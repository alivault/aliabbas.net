{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ali-abbas",
  "compatibility_date": "2025-12-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "d1_databases": [
    {
      "binding": "CHAT_DB",
      "database_name": "ali-chat-conversations",
      "database_id": "11617865-9800-434e-9dab-de6c0bad1719",
    },
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "2026032601",
      "simple": {
        "limit": 12,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "routes": [
    {
      "pattern": "aliabbas.dev",
      "custom_domain": true,
    },
    {
      "pattern": "www.aliabbas.dev",
      "custom_domain": true,
    },
    {
      "pattern": "aliabbas.net",
      "custom_domain": true,
    },
    {
      "pattern": "www.aliabbas.net",
      "custom_domain": true,
    },
  ],
  "vars": {
    "VITE_CONVEX_URL": "https://valiant-penguin-216.convex.cloud",
    "VITE_CONVEX_SITE_URL": "https://valiant-penguin-216.convex.site",
  },
}
